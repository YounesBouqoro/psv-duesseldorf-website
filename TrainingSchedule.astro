---
interface Session {
  groupName: string;
  weekday: string;
  startTime: string;
  endTime: string;
  location: string;
  notes?: string;
}

interface Props {
  sessions: Session[];
}

const { sessions } = Astro.props;
---

<div class="training-list">
  {sessions.map((session) => (
    <div class="training card">
      <strong>{session.groupName}</strong>
      <p>{session.weekday}, {session.startTime}–{session.endTime}</p>
      <p class="muted">{session.location}</p>
      {session.notes && <small>{session.notes}</small>}
    </div>
  ))}
</div>

<style>
  .training-list {
    display: grid;
    gap: 14px;
  }

  .training {
    padding: 18px;
  }

  p {
    margin: 6px 0;
  }
</style>
