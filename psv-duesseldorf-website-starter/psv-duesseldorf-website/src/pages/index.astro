---
import Layout from '../components/layout/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import SportCard from '../components/sport/SportCard.astro';
import { getCollection } from 'astro:content';

const sportarten = await getCollection('sportarten');
const featured = sportarten.filter((item) => item.data.featured).slice(0, 6);
---

<Layout title="Startseite">
  <HeroSection
    eyebrow="Polizei-Sport-Verein Düsseldorf e.V."
    title="Ein Verein. Viele Sportarten. Eine starke Gemeinschaft."
    text="Der PSV Düsseldorf verbindet Tradition, Vielfalt und modernes Vereinsleben – für Kinder, Jugendliche, Erwachsene, Familien und ambitionierte Sportler."
    primaryLabel="Sportart finden"
    primaryHref="/psv-duesseldorf-website/sportarten/"
    secondaryLabel="Probetraining anfragen"
    secondaryHref="/psv-duesseldorf-website/probetraining/"
  />

  <section class="section">
    <div class="container">
      <h2>Sportarten im PSV</h2>
      <p class="muted">Alle Abteilungen erhalten eine klare, gleichwertige Bühne.</p>
      <div class="grid grid-3">
        {featured.map((item) => (
          <SportCard
            title={item.data.title}
            description={item.data.shortDescription}
            tags={item.data.tags}
            href={`/psv-duesseldorf-website/sportarten/${item.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container card">
      <h2>Mitglied werden oder Probetraining vereinbaren</h2>
      <p class="muted">Der Einstieg soll einfach, klar und schnell möglich sein.</p>
      <a class="button" href="/psv-duesseldorf-website/mitglied-werden/">Mitglied werden</a>
    </div>
  </section>
</Layout>
