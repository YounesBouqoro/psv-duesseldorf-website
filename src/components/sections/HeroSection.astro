---
interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  title,
  text,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref
} = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="lead">{text}</p>
    <div class="actions">
      {primaryLabel && primaryHref && <a class="button" href={primaryHref}>{primaryLabel}</a>}
      {secondaryLabel && secondaryHref && <a class="button secondary" href={secondaryHref}>{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 72px;
    background:
      radial-gradient(circle at 20% 20%, rgba(57, 169, 53, 0.22), transparent 32%),
      linear-gradient(180deg, #0b0f14, #0d141c);
  }

  .hero-inner {
    max-width: 920px;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .lead {
    max-width: 720px;
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
</style>

