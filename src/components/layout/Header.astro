---
import navigation from "../../data/navigation.json";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/psv-duesseldorf-website/">
      <img src="/psv-duesseldorf-website/brand/logo.png" alt="PSV Düsseldorf Logo" width="44" height="44" />
      <span>PSV Düsseldorf</span>
    </a>

    <nav aria-label="Hauptnavigation">
      {navigation.main.map((item) => (
        <a href={`/psv-duesseldorf-website${item.href}`}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--header-bg);
    color: var(--header-text);
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--header-text);
    font-weight: 800;
    text-decoration: none;
  }

  .brand img {
    display: block;
    border-radius: 999px;
    background: #ffffff;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--header-text);
    text-decoration: none;
    font-weight: 700;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  @media (max-width: 860px) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      padding-block: 14px;
    }
  }
</style>

