---
import { withBase } from "../../utils/paths";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>PSV Düsseldorf</strong>
      <p>Ein Verein, viele Sportarten, eine starke Gemeinschaft.</p>
      <a class="footer-cta" href={withBase("/probetraining/")}>Probetraining anfragen</a>
    </div>

    <div class="footer-column">
      <h2>Verein</h2>
      <a href={withBase("/verein/")}>Über den Verein</a>
      <a href={withBase("/sportarten/")}>Sportarten</a>
      <a href={withBase("/fussball/")}>Fußball</a>
      <a href={withBase("/mitglied-werden/")}>Mitglied werden</a>
      <a href={withBase("/kinderschutz/")}>Kinderschutz</a>
    </div>

    <div class="footer-column">
      <h2>Service</h2>
      <a href={withBase("/fussball/probetraining/")}>Fußball-Probetraining</a>
      <a href={withBase("/kurse/")}>Kurse</a>
      <a href={withBase("/downloads/")}>Downloads</a>
      <a href={withBase("/partner/")}>Partner</a>
      <a href={withBase("/sponsoring/")}>Sponsoring</a>
      <a href={withBase("/kontakt/")}>Kontakt</a>
    </div>

    <div class="footer-column">
      <h2>Rechtliches</h2>
      <a href={withBase("/impressum/")}>Impressum</a>
      <a href={withBase("/datenschutz/")}>Datenschutz</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© PSV Düsseldorf</span>
    <span>Der Sportverein für alle</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 56px 0 24px;
    background: #ffffff;
    color: var(--text);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(260px, 1.5fr) repeat(3, minmax(160px, 1fr));
    gap: 36px;
  }

  .footer-brand strong {
    display: block;
    font-size: 1.25rem;
    margin-bottom: 10px;
  }

  .footer-brand p,
  .footer-bottom {
    color: var(--muted);
  }

  .footer-cta {
    display: inline-flex;
    margin-top: 12px;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
    font-weight: 900;
    text-decoration: none;
  }

  .footer-column {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .footer-column h2 {
    margin-bottom: 8px;
    font-size: 1rem;
  }

  a {
    color: var(--accent-strong);
    text-decoration: none;
    font-weight: 800;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
