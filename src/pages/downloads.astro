---
import Layout from "../components/layout/Layout.astro";

const downloads = [
  {
    category: "Mitgliedschaft",
    items: [
      {
        title: "Beitrittserklärung",
        description: "Formular mit SEPA-Mandat und veröffentlichter Beitragsübersicht.",
        href: "https://polizei-sv-duesseldorf.de/wp-content/uploads/2022/01/PSV_Beitrittserklaerung_2022_online.pdf",
        meta: "PDF · 2 Seiten"
      },
      {
        title: "Satzung",
        description: "Satzung des Polizei-Sport-Verein Düsseldorf e.V.",
        href: "https://polizei-sv-duesseldorf.de/wp-content/uploads/2020/06/Satzung_Polizei-Sport-Verein_Duesseldorf.pdf",
        meta: "PDF · 9 Seiten"
      }
    ]
  },
  {
    category: "Fußball",
    items: [
      {
        title: "Antrag auf Spielberechtigung",
        description: "Verbandsformular für die Fußball-Spielberechtigung.",
        href: "https://polizei-sv-duesseldorf.de/wp-content/uploads/2021/09/wdfv-antrag_spielberechtigung_stand_06.01.2020_1.pdf",
        meta: "PDF"
      }
    ]
  },
  {
    category: "Kinderschutz",
    items: [
      {
        title: "Kinder- und Jugendschutzkonzept",
        description: "Vollständiges, am 26. März 2026 beschlossenes Schutzkonzept.",
        href: "https://polizei-sv-duesseldorf.de/wp-content/uploads/2026/04/Kinderschutz-PSV.pdf",
        meta: "PDF · 6 Seiten"
      }
    ]
  },
  {
    category: "Kurse",
    items: [
      {
        title: "Anmeldung Selbstverteidigung",
        description: "Anmeldeformular für das Kursangebot Selbstverteidigung und Selbstbehauptung.",
        href: "https://polizei-sv-duesseldorf.de/wp-content/uploads/2023/12/Polizei-Sport-Verein_Duesseldorf_Kurs_FSBK2024_Anmeldung.pdf",
        meta: "PDF · vor Verwendung Termin prüfen"
      }
    ]
  }
];
---

<Layout title="Downloads" description="Formulare, Satzung und Schutzkonzept des PSV Düsseldorf.">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Service</p>
      <h1>Downloads</h1>
      <p class="intro">Zentrale Formulare und Vereinsdokumente aus der offiziellen PSV-Quelle.</p>
    </div>
  </section>

  <section class="section">
    <div class="container download-list">
      {downloads.map((group) => (
        <section>
          <h2>{group.category}</h2>
          <div class="download-grid">
            {group.items.map((item) => (
              <article class="download-card">
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <span>{item.meta}</span>
                </div>
                <a href={item.href} target="_blank" rel="noreferrer">PDF öffnen</a>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, #ffffff, #f2f8ee); }
  .eyebrow { color: var(--accent-strong); font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 16px 0 20px; font-size: clamp(44px, 7vw, 76px); }
  .intro, .download-card p { color: var(--muted); }
  .download-list { display: grid; gap: 42px; }
  .download-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .download-card { display: flex; justify-content: space-between; gap: 24px; padding: 28px; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow); }
  .download-card span { display: inline-flex; padding: 6px 11px; border-radius: 999px; background: #eef7e8; color: var(--accent-strong); font-size: .82rem; font-weight: 900; }
  .download-card a { align-self: start; white-space: nowrap; color: var(--accent-strong); font-weight: 900; }
  @media (max-width: 800px) { .download-grid { grid-template-columns: 1fr; } .download-card { flex-direction: column; } }
</style>
