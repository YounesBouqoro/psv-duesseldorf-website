---
import Layout from "../components/layout/Layout.astro";

const downloads = [
  {
    category: "Mitgliedschaft",
    items: [
      {
        title: "Beitrittserklärung PSV Düsseldorf",
        description: "Zentrales Formular für die Vereinsmitgliedschaft.",
        href: "#",
        status: "PDF noch hochladen"
      },
      {
        title: "Satzung des PSV Düsseldorf",
        description: "Offizielle Vereinssatzung.",
        href: "#",
        status: "PDF noch hochladen"
      }
    ]
  },
  {
    category: "Fußball",
    items: [
      {
        title: "Antrag auf Spielberechtigung",
        description: "Formular für den Fußball-Spielbetrieb.",
        href: "#",
        status: "PDF noch hochladen"
      }
    ]
  },
  {
    category: "Kurse",
    items: [
      {
        title: "Anmeldung Selbstverteidigung für Frauen",
        description: "Anmeldeformular für Kursangebote.",
        href: "#",
        status: "PDF noch hochladen"
      }
    ]
  },
  {
    category: "Sportarten",
    items: [
      {
        title: "Faustball Informationen",
        description: "Informationsmaterial zur Abteilung Faustball.",
        href: "#",
        status: "Optional als HTML übertragen"
      },
      {
        title: "Karate Trainingsinformationen",
        description: "Informationen zu Training, Trainingsorten und Kinderkarate.",
        href: "#",
        status: "Optional als HTML übertragen"
      },
      {
        title: "Hundesport Informationen",
        description: "Materialien zu Agility, Obedience und Begleithundeprüfung.",
        href: "#",
        status: "Optional als HTML übertragen"
      }
    ]
  }
];
---

<Layout title="Downloads">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Servicebereich</p>
      <h1>Downloads</h1>
      <p class="intro">
        Hier werden zentrale Formulare, Vereinspapiere und Informationsmaterialien gebündelt.
        Die Dateien werden im Relaunch sauber benannt, geprüft und thematisch sortiert.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container download-list">
      {
        downloads.map((group) => (
          <section class="download-group">
            <h2>{group.category}</h2>

            <div class="download-grid">
              {group.items.map((item) => (
                <article class="download-card">
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                    <span>{item.status}</span>
                  </div>

                  <a href={item.href} class="download-link" aria-disabled="true">
                    Download vorbereiten
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.98;
    margin: 16px 0 24px;
  }

  .intro {
    max-width: 760px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .download-list {
    display: grid;
    gap: 44px;
  }

  .download-group h2 {
    margin-bottom: 20px;
  }

  .download-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .download-card {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 26px;
    background: #ffffff;
    box-shadow: 0 16px 50px rgba(0,0,0,0.06);
  }

  .download-card p {
    color: var(--muted);
  }

  .download-card span {
    display: inline-flex;
    margin-top: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #f3f8ef;
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .download-link {
    white-space: nowrap;
    align-self: start;
    color: var(--accent-strong);
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .download-grid {
      grid-template-columns: 1fr;
    }

    .download-card {
      flex-direction: column;
    }
  }
</style>
