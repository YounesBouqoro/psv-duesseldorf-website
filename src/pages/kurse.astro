---
import Layout from "../components/layout/Layout.astro";
import { withBase } from "../utils/paths";
---

<Layout title="Kurse" description="Kursangebote des PSV Düsseldorf, darunter Selbstverteidigung und Selbstbehauptung für Frauen.">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Zusatzangebote</p>
      <h1>Kurse beim PSV Düsseldorf</h1>
      <p class="intro">Wechselnde Präventions- und Bewegungsangebote ergänzen den regulären Vereinssport.</p>
    </div>
  </section>

  <section class="section">
    <div class="container course-grid">
      <article class="course-card">
        <p class="eyebrow">Präventionskurs</p>
        <h2>Selbstverteidigung und Selbstbehauptung für Frauen</h2>
        <p>
          Der Kurs stärkt Selbstbewusstsein, Selbstsicherheit und Handlungskompetenz im Umgang
          mit Angst und Gewalt. Sportliche Übungen werden durch Theorie und Rollenspiele ergänzt.
        </p>
        <ul>
          <li>einfache und effektive Verteidigungsabläufe</li>
          <li>Notwehrrechte und Verhalten in Notsituationen</li>
          <li>Handlungssicherheit und selbstbewusstes Auftreten</li>
          <li>Hinweise zu Hilfs- und Beratungsangeboten</li>
        </ul>
        <p class="notice">
          Der zuletzt veröffentlichte Kurszeitraum ist beendet. Neue Termine bitte direkt bei der
          Geschäftsstelle erfragen.
        </p>
        <a class="button" href={withBase("/kontakt/")}>Neue Termine anfragen</a>
      </article>

      <aside class="info-card">
        <h2>Kontakt</h2>
        <p>
          Polizei-Sport-Verein Düsseldorf e.V.<br />
          Ernst-Poensgen-Allee 60<br />
          40629 Düsseldorf
        </p>
        <a href="tel:+4921173283065">0211 / 73 28 30 65</a>
        <a href="mailto:contact@polizei-sv-duesseldorf.de">contact@polizei-sv-duesseldorf.de</a>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, #ffffff, #f2f8ee); }
  .eyebrow { color: var(--accent-strong); font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 16px 0 20px; font-size: clamp(44px, 7vw, 76px); }
  .intro, .course-card p, .info-card p, li { color: var(--muted); }
  .course-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; align-items: start; }
  .course-card, .info-card { padding: 32px; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow); }
  li { margin-bottom: 8px; }
  .notice { margin: 22px 0; padding: 16px; border-radius: 16px; background: #fff4d8; }
  .button { display: inline-flex; min-height: 46px; align-items: center; padding: 0 20px; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 900; text-decoration: none; }
  .info-card a { display: block; margin-top: 10px; color: var(--accent-strong); font-weight: 900; }
  @media (max-width: 800px) { .course-grid { grid-template-columns: 1fr; } }
</style>
