---
import Layout from "../components/layout/Layout.astro";

const courses = [
  {
    title: "Selbstverteidigung & Selbstbehauptung",
    text: "Kursangebot mit Fokus auf Sicherheit, Wahrnehmung, Grenzen und praktisches Verhalten.",
    status: "Inhalt final prüfen"
  },
  {
    title: "Weitere Kursangebote",
    text: "Künftige Kurse können hier zentral sichtbar gemacht werden.",
    status: "Struktur vorbereitet"
  }
];
---

<Layout title="Kurse">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Kursangebote</p>
      <h1>Kurse beim PSV Düsseldorf</h1>
      <p class="intro">
        Neben den regulären Sportarten bietet der PSV Düsseldorf auch Kurse und Sonderangebote an.
        Dieser Bereich wird als zentrale Kursübersicht aufgebaut.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container course-grid">
      {courses.map((course) => (
        <article class="course-card">
          <span>{course.status}</span>
          <h2>{course.title}</h2>
          <p>{course.text}</p>
          <a href="/psv-duesseldorf-website/kontakt/">Anfrage stellen</a>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 980px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.98;
    margin: 16px 0 24px;
  }

  .intro {
    max-width: 760px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .course-card {
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .course-card span {
    display: inline-flex;
    margin-bottom: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #f3f8ef;
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .course-card p {
    color: var(--muted);
    margin-bottom: 22px;
  }

  .course-card a {
    color: var(--accent-strong);
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .course-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
