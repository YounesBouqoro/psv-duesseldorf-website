---
import Layout from "../components/layout/Layout.astro";
---

<Layout title="Kinder- und Jugendschutz" description="Kinder- und Jugendschutzkonzept des Polizei-Sport-Verein Düsseldorf e.V.">
  <section class="section page-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Verantwortung</p>
        <h1>Kinder- und Jugendschutz</h1>
        <p class="intro">
          Der PSV Düsseldorf übernimmt Verantwortung für das Wohlergehen aller Kinder und Jugendlichen.
          Der Verein soll ein sicherer Ort sein – frei von Gewalt, Missbrauch, Diskriminierung und Grenzverletzungen.
        </p>
      </div>
      <aside class="status-card">
        <strong>Beschlossen am 26.03.2026</strong>
        <p>durch den Gesamtvorstand des Polizei-Sport-Verein Düsseldorf e.V.</p>
        <a href="https://polizei-sv-duesseldorf.de/wp-content/uploads/2026/04/Kinderschutz-PSV.pdf" target="_blank" rel="noreferrer">Vollständiges Konzept als PDF</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container card-grid">
      <article class="info-card">
        <h2>Prävention</h2>
        <ul>
          <li>verbindlicher Verhaltenskodex</li>
          <li>erweiterte Führungszeugnisse</li>
          <li>regelmäßige Schulungen und Sensibilisierung</li>
          <li>klare Zuständigkeiten und offene Trainingssituationen</li>
        </ul>
      </article>
      <article class="info-card">
        <h2>Bei einem Verdacht</h2>
        <ol>
          <li>Wahrnehmen und ernst nehmen</li>
          <li>sachlich dokumentieren</li>
          <li>Schutzbeauftragte oder Vorstand informieren</li>
          <li>erforderliche Schutzmaßnahmen einleiten</li>
        </ol>
      </article>
      <article class="info-card">
        <h2>Grundprinzipien</h2>
        <ul>
          <li>Der Schutz des Kindes hat oberste Priorität.</li>
          <li>Keine Alleingänge und keine Vorverurteilung.</li>
          <li>Dokumentation statt Bewertung.</li>
          <li>Vertraulicher Umgang und Schutz aller Beteiligten.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <p class="eyebrow">Beratung und Hilfe</p>
      <h2>Ansprechstellen</h2>
      <div class="contact-grid">
        <article class="contact-card">
          <h3>KidsCare</h3>
          <p>Sophie Bökmann · Ansprechpartnerin für den PSV Düsseldorf</p>
          <a href="mailto:boekmann@kinderschutzbund-duesseldorf.de">boekmann@kinderschutzbund-duesseldorf.de</a>
          <a href="tel:+4921161705733">0211 / 61705733</a>
        </article>
        <article class="contact-card">
          <h3>Jugendamt Düsseldorf – Kinderschutz</h3>
          <a href="tel:+492118922033">0211 / 8922033</a>
        </article>
        <article class="contact-card">
          <h3>Stadtsportbund Düsseldorf – Kinderschutz</h3>
          <a href="tel:+4921120054421">0211 / 20054421</a>
        </article>
        <article class="contact-card emergency">
          <h3>Akuter Notfall</h3>
          <p>Polizei: <a href="tel:110">110</a><br />Feuerwehr und Rettungsdienst: <a href="tel:112">112</a></p>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, #ffffff, #f2f8ee); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 36px; align-items: center; }
  .eyebrow { color: var(--accent-strong); font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 16px 0 22px; font-size: clamp(44px, 7vw, 76px); line-height: .98; }
  .intro, .status-card p, .info-card li, .contact-card p { color: var(--muted); }
  .status-card, .info-card, .contact-card { padding: 28px; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow); }
  .status-card a, .contact-card a { display: block; margin-top: 8px; color: var(--accent-strong); font-weight: 900; }
  .card-grid, .contact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .contact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  li { margin-bottom: 9px; }
  .light-section { background: var(--surface); }
  .emergency { border-color: #e2a4a4; }
  @media (max-width: 850px) { .hero-grid, .card-grid, .contact-grid { grid-template-columns: 1fr; } }
</style>
