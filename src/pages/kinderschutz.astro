---
import Layout from "../components/layout/Layout.astro";
---

<Layout title="Kinderschutz">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Verantwortung</p>
      <h1>Kinderschutz im Verein</h1>
      <p class="muted">
        Kinderschutz ist ein wichtiger Bestandteil moderner Vereinsarbeit, insbesondere in Sportangeboten mit Kindern und Jugendlichen.
      </p>

      <div class="card">
        <h2>Transparente Informationen</h2>
        <p>
          Diese Seite soll künftig zentrale Informationen zu Ansprechpartnern, Schutzkonzept, Verhaltensregeln und Meldewegen bündeln.
          Konkrete Namen und Dokumente werden erst nach offizieller Freigabe ergänzt.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .eyebrow {
    color: var(--accent-strong);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
