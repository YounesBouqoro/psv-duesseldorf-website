---
import Layout from "../components/layout/Layout.astro";
import { withBase } from "../utils/paths";

const facts = [
  "Mehrspartenverein in Düsseldorf",
  "Sportangebote für unterschiedliche Altersgruppen",
  "Vereinsleben mit Abteilungen und Kursangeboten",
  "Gemeinnütziger, eingetragener Verein"
];

const priorities = [
  {
    title: "Sportarten sichtbar machen",
    text: "Elf Abteilungen geben einen Überblick über Trainingszeiten, Zielgruppen und direkte Kontaktwege."
  },
  {
    title: "Mitgliedschaft vereinfachen",
    text: "Interessierte finden Probetraining, Beitrittserklärung und weitere Unterlagen an zentraler Stelle."
  },
  {
    title: "Vertrauen stärken",
    text: "Kinderschutz, Ansprechpersonen, Vereinsdaten und rechtliche Informationen sind transparent zugänglich."
  }
];
---

<Layout title="Verein">
  <section class="section page-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Der Verein</p>
        <h1>Polizei-Sport-Verein Düsseldorf e.V.</h1>
        <p class="intro">
          Der PSV Düsseldorf ist ein gemeinnütziger Mehrspartenverein für Menschen aus Düsseldorf und Umgebung – nicht nur für Polizeibeschäftigte.
          Im Mittelpunkt stehen Sport, Gemeinschaft, Fairness und ehrenamtliches Engagement.
        </p>
      </div>

      <aside class="status-card">
        <p class="status-label">Geschäftsstelle</p>
        <h2>Ernst-Poensgen-Allee 60</h2>
        <p>
          40629 Düsseldorf<br />Montag bis Donnerstag, 8:30–13:30 Uhr
        </p>
        <a class="text-link" href={withBase("/kontakt/")}>Kontakt und Anfahrt →</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container fact-grid">
      {facts.map((fact) => (
        <div class="fact-card">{fact}</div>
      ))}
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <p class="eyebrow">Orientierung</p>
      <h2>Was du hier findest</h2>

      <div class="priority-grid">
        {priorities.map((item) => (
          <article class="priority-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 44px;
    align-items: start;
  }

  .eyebrow,
  .status-label {
    color: var(--accent-strong);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 980px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.98;
    margin: 16px 0 24px;
  }

  .intro {
    max-width: 760px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .status-card,
  .fact-card,
  .priority-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 28px;
    background: #ffffff;
    box-shadow: 0 16px 50px rgba(0,0,0,0.06);
  }

  .status-card p,
  .priority-card p {
    color: var(--muted);
  }

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .fact-card {
    color: var(--accent-strong);
    font-weight: 900;
  }

  .light-section {
    background: var(--surface);
  }

  .priority-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 28px;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .priority-grid {
      grid-template-columns: 1fr;
    }

    .fact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .fact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
