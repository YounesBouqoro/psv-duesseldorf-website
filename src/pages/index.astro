---
import Layout from "../components/layout/Layout.astro";
---

<Layout title="Startseite">
  <section class="section hero-section">
    <div class="container">
      <p class="eyebrow">Polizei-Sport-Verein Düsseldorf e.V.</p>
      <h1>Ein moderner Mehrspartenverein für Düsseldorf.</h1>
      <p class="muted hero-text">
        Die neue Website bündelt Sportarten, Kurse, Mitgliedschaft, Probetraining, Sponsoring und Kontaktwege an einem zentralen Ort.
      </p>

      <div class="card">
        <h2>Website im Aufbau</h2>
        <p>
          Die technische Basis steht. Als nächstes werden Inhalte, Sportarten, Ansprechpartner und Vereinsinformationen sauber ausgearbeitet.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 920px;
    font-size: clamp(42px, 7vw, 88px);
    line-height: 0.95;
    margin: 16px 0 24px;
  }

  .hero-text {
    max-width: 760px;
    font-size: 1.2rem;
  }
</style>
