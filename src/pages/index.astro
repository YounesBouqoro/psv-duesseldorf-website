---
import Layout from "../components/layout/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../utils/paths";

const sportarten = await getCollection("sportarten");
const featuredSports = sportarten
  .filter((sport) => sport.data.featured)
  .slice(0, 6);

const fallbackSports = sportarten
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 6);

const sportsToShow = featuredSports.length > 0 ? featuredSports : fallbackSports;
---

<Layout title="Startseite">
  <section class="section hero-section">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Polizei-Sport-Verein Düsseldorf e.V.</p>

        <h1>Der Sportverein für alle in Düsseldorf.</h1>

        <p class="hero-text">
          Ob Breiten-, Wettkampf- oder Gesundheitssport: Der PSV Düsseldorf bietet Bewegung,
          Gemeinschaft und passende Angebote für unterschiedliche Altersgruppen.
        </p>

        <div class="hero-actions">
          <a class="button primary" href={withBase("/sportarten/")}>Sportarten entdecken</a>
          <a class="button secondary" href={withBase("/probetraining/")}>Probetraining anfragen</a>
        </div>
      </div>

      <div class="hero-panel">
        <p class="panel-label">Direkt zum Einstieg</p>
        <h2>Dein Sport. Dein Verein.</h2>
        <p>
          Finde Trainingszeiten und Ansprechpersonen direkt bei der jeweiligen Sportart oder nimm zentral Kontakt mit uns auf.
        </p>
      </div>
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Sportangebot</p>
          <h2>Sportarten im Überblick</h2>
        </div>

        <a class="text-link" href={withBase("/sportarten/")}>Alle Sportarten ansehen</a>
      </div>

      <div class="sports-grid">
        {
          sportsToShow.map((sport) => (
            <a class="sport-card" href={withBase(`/sportarten/${sport.id}/`)}>
              <p class="category">{sport.data.category}</p>
              <h3>{sport.data.title}</h3>
              <p>{sport.data.shortDescription}</p>
              <span>Mehr erfahren →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section action-section">
    <div class="container action-grid">
      <div class="action-card">
        <h2>Mitglied werden</h2>
        <p>
          Erfahre, wie der Einstieg funktioniert, und lade die Beitrittserklärung direkt herunter.
        </p>
        <a class="button secondary" href={withBase("/mitglied-werden/")}>Zur Mitgliedschaft</a>
      </div>

      <div class="action-card">
        <h2>Kinderschutz</h2>
        <p>
          Schutz, Respekt und verlässliche Ansprechpersonen gehören zu unserem Vereinsleben.
        </p>
        <a class="button secondary" href={withBase("/kinderschutz/")}>Zum Kinderschutz</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    min-height: 76vh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 48px;
    align-items: center;
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 980px;
    font-size: clamp(44px, 7vw, 86px);
    line-height: 0.96;
    margin: 16px 0 24px;
  }

  .hero-text {
    max-width: 780px;
    font-size: 1.18rem;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
  }

  .primary {
    background: var(--accent);
    color: #ffffff;
  }

  .secondary {
    border: 1px solid var(--accent);
    color: var(--accent-strong);
    background: #ffffff;
  }

  .hero-panel,
  .action-card {
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: 30px;
    background: #ffffff;
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.08);
  }

  .panel-label {
    color: var(--accent-strong);
    font-weight: 800;
  }

  .light-section {
    background: #ffffff;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    margin-bottom: 30px;
  }

  .text-link {
    color: var(--accent-strong);
    font-weight: 800;
    text-decoration: none;
  }

  .sports-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .sport-card {
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 26px;
    background: #ffffff;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sport-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
  }

  .sport-card p {
    color: var(--muted);
  }

  .sport-card span,
  .category {
    color: var(--accent-strong);
    font-weight: 800;
  }

  .category {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .action-section {
    background: var(--surface);
  }

  .action-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .action-card p {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero-grid,
    .action-grid {
      grid-template-columns: 1fr;
    }

    .sports-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .section-head {
      align-items: start;
      flex-direction: column;
    }

    .sports-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
