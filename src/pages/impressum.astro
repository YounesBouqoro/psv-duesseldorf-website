---
import Layout from "../components/layout/Layout.astro";
---

<Layout title="Impressum" description="Impressum und Anbieterkennzeichnung des Polizei-Sport-Verein Düsseldorf e.V.">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Rechtliches</p>
      <h1>Impressum</h1>
      <p class="intro">Angaben zum Anbieter dieser Website.</p>
    </div>
  </section>

  <section class="section">
    <div class="container legal-grid">
      <article class="legal-card">
        <h2>Polizei-Sport-Verein Düsseldorf e.V.</h2>
        <p>Ernst-Poensgen-Allee 60<br />40629 Düsseldorf<br />Deutschland</p>
        <p>
          Telefon: <a href="tel:+4921173283065">0211 / 73 28 30 65</a><br />
          E-Mail: <a href="mailto:contact@polizei-sv-duesseldorf.de">contact@polizei-sv-duesseldorf.de</a>
        </p>
      </article>

      <article class="legal-card">
        <h2>Vertretungsberechtigter Vorstand</h2>
        <dl>
          <div><dt>Vorsitzender</dt><dd>Nils Röher</dd></div>
          <div><dt>1. stellvertretender Vorsitzender</dt><dd>Patrick Winter</dd></div>
          <div><dt>2. stellvertretender Vorsitzender</dt><dd>Soner Bayraktar</dd></div>
          <div><dt>Schatzmeister</dt><dd>Dr. Christian Schünemann</dd></div>
        </dl>
        <p>Inhaltlich verantwortlich: der Vorstand, Anschrift wie oben.</p>
      </article>

      <article class="legal-card">
        <h2>Register und Steuernummer</h2>
        <p>
          Registergericht: Amtsgericht Düsseldorf<br />
          Vereinsregister: VR 1001203<br />
          Steuernummer: 102/5886/2040
        </p>
      </article>

      <article class="legal-card">
        <h2>Haftung für externe Links</h2>
        <p>
          Diese Website enthält Links zu externen Angeboten. Für deren Inhalte sind ausschließlich
          die jeweiligen Betreiber verantwortlich.
        </p>
      </article>

      <article class="legal-card">
        <h2>Urheberrecht</h2>
        <p>
          Texte, Bilder und sonstige Inhalte dieser Website dürfen nur im Rahmen der gesetzlichen
          Bestimmungen oder mit ausdrücklicher Zustimmung des Rechteinhabers verwendet werden.
        </p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, #ffffff, #f2f8ee); }
  .eyebrow { color: var(--accent-strong); font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 16px 0 20px; font-size: clamp(44px, 7vw, 76px); }
  .intro, .legal-card p, dd { color: var(--muted); }
  .legal-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .legal-card { padding: 30px; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow); }
  .legal-card a { color: var(--accent-strong); font-weight: 800; }
  dl { display: grid; gap: 14px; }
  dt { font-weight: 900; }
  dd { margin: 2px 0 0; }
  @media (max-width: 800px) { .legal-grid { grid-template-columns: 1fr; } }
</style>
