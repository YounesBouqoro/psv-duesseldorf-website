---
import Layout from "../components/layout/Layout.astro";
import { footballTeams } from "../data/footballTeams";
import { withBase } from "../utils/paths";

const seniorTeams = footballTeams.filter((team) => team.category === "Senioren");
const youthTeams = footballTeams.filter((team) => team.category === "Jugend");
const youthGroups = [...new Set(youthTeams.map((team) => team.ageGroup))].map((ageGroup) => ({
  ageGroup,
  teams: youthTeams.filter((team) => team.ageGroup === ageGroup)
}));
---

<Layout
  title="Fußball"
  description="Fußball beim PSV Düsseldorf: 23 Mannschaften, Jugend- und Seniorenbereich sowie Probetraining auf der Sportanlage in Grafenberg."
>
  <section class="section football-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Fußball beim PSV</p>
        <h1>23 Mannschaften. Eine gemeinsame Heimat.</h1>
        <p class="intro">
          Auf der vereinseigenen Sportanlage in Grafenberg trainieren Jugend- und
          Seniorenmannschaften von Montag bis Freitag auf zwei Kunstrasenplätzen.
        </p>
        <div class="actions">
          <a class="button primary" href={withBase("/fussball/probetraining/")}>Probetraining anfragen</a>
          <a class="button secondary" href={withBase("/mitglied-werden/")}>Mitgliedschaft</a>
        </div>
      </div>

      <aside class="fact-card">
        <strong>{footballTeams.length}</strong>
        <span>Mannschaften</span>
        <p>Von der G-Jugend bis zu den Senioren und Alten Herren.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container section-head">
      <p class="eyebrow">Senioren</p>
      <h2>Seniorenmannschaften</h2>
    </div>
    <div class="container team-grid">
      {seniorTeams.map((team) => (
        <a class="team-card" href={withBase(`/fussball/teams/${team.slug}/`)}>
          <span>{team.ageGroup}</span>
          <h3>{team.name}</h3>
          <p>{team.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section light-section">
    <div class="container section-head">
      <p class="eyebrow">Nachwuchs</p>
      <h2>Jugendmannschaften</h2>
      <p>
        Die Jahrgänge entsprechen der aktuell veröffentlichten Mannschaftsstruktur.
        Ein Platz wird erst nach Rückmeldung der zuständigen Mannschaft bestätigt.
      </p>
    </div>

    <div class="container age-stack">
      {youthGroups.map((group) => (
        <section class="age-section">
          <div class="age-head">
            <h3>{group.ageGroup}</h3>
            <span>{group.teams.length} {group.teams.length === 1 ? "Team" : "Teams"}</span>
          </div>
          <div class="team-grid">
            {group.teams.map((team) => (
              <a class="team-card" href={withBase(`/fussball/teams/${team.slug}/`)}>
                <span>Jahrgang {team.birthYears}</span>
                <h3>{team.name}</h3>
                <p>{team.description}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container info-grid">
      <article class="info-card">
        <p class="eyebrow">Sportanlage</p>
        <h2>Training in Grafenberg</h2>
        <p>Ernst-Poensgen-Allee 60, 40625 Düsseldorf</p>
        <p>Großer Kunstrasenplatz und zusätzlicher Kunstrasen-Halbfeldplatz.</p>
      </article>
      <article class="info-card">
        <p class="eyebrow">Beiträge</p>
        <h2>Fußball-Mitgliedschaft</h2>
        <p>Jugendliche: 150 Euro Jahresbeitrag</p>
        <p>Senioren: 170 Euro Jahresbeitrag</p>
      </article>
      <article class="info-card">
        <p class="eyebrow">Kontakt</p>
        <h2>Spielanfragen</h2>
        <a href="mailto:anfrage@polizei-sv-duesseldorf.de">anfrage@polizei-sv-duesseldorf.de</a>
      </article>
    </div>
  </section>
</Layout>

<style>
  .football-hero {
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.2), transparent 36%),
      linear-gradient(135deg, #ffffff, #f2f8ee);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 42px;
    align-items: center;
  }
  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 900px;
    margin: 16px 0 24px;
    font-size: clamp(44px, 7vw, 80px);
    line-height: 0.96;
  }
  .intro,
  .section-head > p:last-child,
  .team-card p,
  .info-card p,
  .fact-card p {
    color: var(--muted);
  }
  .intro {
    max-width: 760px;
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }
  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 900;
    text-decoration: none;
  }
  .primary {
    background: var(--accent);
    color: #ffffff;
  }
  .secondary {
    border: 1px solid var(--accent);
    color: var(--accent-strong);
  }
  .fact-card,
  .team-card,
  .info-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow);
  }
  .fact-card strong {
    display: block;
    color: var(--accent-strong);
    font-size: 4rem;
    line-height: 1;
  }
  .fact-card span {
    font-weight: 900;
  }
  .section-head {
    margin-bottom: 28px;
  }
  .team-grid,
  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  .team-card {
    color: inherit;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease;
  }
  .team-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .team-card > span,
  .age-head span {
    display: inline-flex;
    margin-bottom: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #eef7e8;
    color: var(--accent-strong);
    font-size: 0.85rem;
    font-weight: 900;
  }
  .light-section {
    background: var(--surface);
  }
  .age-stack {
    display: grid;
    gap: 42px;
  }
  .age-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }
  .age-head h3 {
    font-size: 1.6rem;
  }
  .info-card a {
    color: var(--accent-strong);
    font-weight: 900;
  }
  @media (max-width: 900px) {
    .hero-grid,
    .team-grid,
    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
