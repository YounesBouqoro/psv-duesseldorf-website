---
import Layout from "../components/layout/Layout.astro";
import { footballTeams } from "../data/footballTeams";

const seniorTeams = footballTeams.filter((team) => team.category === "Senioren").sort((a, b) => a.priority - b.priority);
const youthTeams = footballTeams.filter((team) => team.category === "Jugend").sort((a, b) => a.priority - b.priority);
---

<Layout title="Fußball">
  <section class="section football-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">PSV Düsseldorf Fußball</p>

        <h1>
          Moderne Fußballabteilung mit Jugend- und Seniorenfußball
        </h1>

        <p class="intro">
          Die Fußballabteilung des PSV Düsseldorf verbindet Nachwuchsförderung,
          Vereinsleben und ambitionierten Amateurfußball in einer modernen Vereinsstruktur.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="/psv-duesseldorf-website/fussball/probetraining/">
            Probetraining anfragen
          </a>

          <a class="button secondary" href="/psv-duesseldorf-website/mitglied-werden/">
            Mitglied werden
          </a>
        </div>
      </div>

      <div class="hero-card">
        <span>{footballTeams.length}</span>
        <strong>Mannschaften im Fußballbereich</strong>
        <p>
          Jugend- und Seniorenfußball mit skalierbarer Teamstruktur.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Senioren</p>
          <h2>Seniorenmannschaften</h2>
        </div>
      </div>

      <div class="team-grid">
        {seniorTeams.map((team) => (
          <a
            class="team-card"
            href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}
          >
            <div class="team-top">
              <span class="badge">{team.ageGroup}</span>
            </div>

            <h3>{team.name}</h3>

            <p>{team.description}</p>

            <div class="team-meta">
              <span>{team.trainingDays.join(" • ")}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Jugend</p>
          <h2>Jugendmannschaften</h2>
        </div>
      </div>

      <div class="team-grid">
        {youthTeams.map((team) => (
          <a
            class="team-card"
            href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}
          >
            <div class="team-top">
              <span class="badge">{team.ageGroup}</span>
            </div>

            <h3>{team.name}</h3>

            <p>{team.description}</p>

            <div class="team-meta">
              <span>{team.trainingDays.join(" • ")}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section football-process">
    <div class="container process-grid">
      <article class="process-card">
        <p class="eyebrow">Einstieg</p>
        <h2>Probetraining</h2>
        <p>
          Interessierte Spielerinnen und Spieler können über die Fußball-Probetrainingsseite
          eine strukturierte Anfrage stellen. So landen Name, Jahrgang und bisherige Erfahrung
          direkt im richtigen Kontext.
        </p>
        <a class="text-link" href="/psv-duesseldorf-website/fussball/probetraining/">
          Zum Fußball-Probetraining →
        </a>
      </article>

      <article class="process-card">
        <p class="eyebrow">Mitgliedschaft</p>
        <h2>Anmeldung</h2>
        <p>
          Nach einem erfolgreichen Probetraining folgt die offizielle Anmeldung über die
          Vereinsunterlagen. Die finalen Formulare werden vor Livegang noch geprüft und sauber verlinkt.
        </p>
        <a class="text-link" href="/psv-duesseldorf-website/mitglied-werden/">
          Mitglied werden →
        </a>
      </article>

      <article class="process-card">
        <p class="eyebrow">Struktur</p>
        <h2>Mannschaften</h2>
        <p>
          Die Mannschaften werden zentral über ein Datenmodell gepflegt. Dadurch bleiben
          Übersicht, Teamseiten und Sitemap langfristig konsistent.
        </p>
        <a class="text-link" href="/psv-duesseldorf-website/fussball/">
          Mannschaften ansehen →
        </a>
      </article>
    </div>
  </section>
</Layout>

<style>
  .football-hero {
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 40px;
    align-items: center;
  }

  .hero-card {
    padding: 36px;
    border-radius: var(--radius);
    background: #ffffff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .hero-card span {
    display: block;
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
    color: var(--accent-strong);
  }

  .hero-card strong {
    display: block;
    margin: 12px 0;
    font-size: 1.2rem;
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.96;
    margin: 18px 0 24px;
  }

  .intro {
    max-width: 720px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 900;
  }

  .primary {
    background: var(--accent);
    color: #ffffff;
  }

  .secondary {
    border: 1px solid var(--accent);
    background: #ffffff;
    color: var(--accent-strong);
  }

  .light-section {
    background: var(--surface);
  }

  .section-head {
    margin-bottom: 30px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .team-card {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow);
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .team-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(127, 194, 65, 0.12);
    color: var(--accent-strong);
    font-weight: 800;
  }

  .team-card p {
    color: var(--muted);
  }

  .team-meta {
    margin-top: 22px;
    color: var(--accent-strong);
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
  .football-process {
    background: #ffffff;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .process-card {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .process-card p {
    color: var(--muted);
  }

  .text-link {
    display: inline-flex;
    margin-top: 22px;
    color: var(--accent-strong);
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

