---
import Layout from "../components/layout/Layout.astro";
import { footballTeams } from "../data/footballTeams";

const seniorTeams = footballTeams
  .filter((team) => team.category === "Senioren")
  .sort((a, b) => a.priority - b.priority);

const youthTeams = footballTeams
  .filter((team) => team.category === "Jugend")
  .sort((a, b) => a.priority - b.priority);

const dataQualityStats = {
  totalTeams: footballTeams.length,
  offeneTrainingszeiten: footballTeams.filter((team) => !team.dataChecklist?.trainingszeitenGeprueft).length,
  offeneTrainerdaten: footballTeams.filter((team) => !team.dataChecklist?.trainerGeprueft).length,
  offeneKontakte: footballTeams.filter((team) => !team.dataChecklist?.kontaktGeprueft).length,
  fehlendesBildmaterial: footballTeams.filter((team) => !team.dataChecklist?.bildmaterialVorhanden).length
};

const youthGroups = [
  {
    label: "A-Jugend",
    ageGroup: "U19",
    teams: youthTeams.filter((team) => team.ageGroup === "U19")
  },
  {
    label: "B-Jugend",
    ageGroup: "U17",
    teams: youthTeams.filter((team) => team.ageGroup === "U17")
  },
  {
    label: "C-Jugend",
    ageGroup: "U15",
    teams: youthTeams.filter((team) => team.ageGroup === "U15")
  },
  {
    label: "D-Jugend",
    ageGroup: "U13",
    teams: youthTeams.filter((team) => team.ageGroup === "U13")
  },
  {
    label: "E-Jugend",
    ageGroup: "U11",
    teams: youthTeams.filter((team) => team.ageGroup === "U11")
  },
  {
    label: "F-Jugend",
    ageGroup: "U9",
    teams: youthTeams.filter((team) => team.ageGroup === "U9")
  },
  {
    label: "G-Jugend",
    ageGroup: "U7",
    teams: youthTeams.filter((team) => team.ageGroup === "U7")
  }
];
---

<Layout title="Fußball">
  <section class="section football-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">PSV Düsseldorf Fußball</p>

        <h1>Fußball beim PSV Düsseldorf</h1>

        <p class="intro">
          Der Fußballbereich wird als skalierbare Abteilung mit Senioren, Jugendteams,
          Teamseiten und Probetrainingsprozess aufgebaut.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="/psv-duesseldorf-website/fussball/probetraining/">
            Fußball-Probetraining anfragen
          </a>

          <a class="button secondary" href="/psv-duesseldorf-website/mitglied-werden/">
            Mitglied werden
          </a>
        </div>
      </div>

      <div class="hero-card">
        <span>{footballTeams.length}</span>
        <strong>Mannschaften & Team-Slots</strong>
        <p>Saubere Struktur für Senioren, Jugend und spätere echte Vereinsdaten.</p>
      </div>
    </div>
  </section>

  <section class="football-anchor-bar">
    <div class="container anchor-inner">
      <a href="#senioren">Senioren</a>
      {youthGroups.map((group) => (
        <a href={`#${group.ageGroup.toLowerCase()}`}>{group.label}</a>
      ))}
      <a href="#einstieg">Probetraining & Anmeldung</a>
      <a href="/psv-duesseldorf-website/fussball/datencheck/">Datencheck</a>
    </div>
  </section>

  <section id="senioren" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Senioren</p>
        <h2>Seniorenmannschaften</h2>
      </div>

      <div class="team-grid">
        {seniorTeams.map((team) => (
          <a class="team-card" href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}>
            <div class="team-top">
              <span class="badge">{team.ageGroup}</span>
              <span class="status-badge">Daten prüfen</span>
            </div>

            <h3>{team.name}</h3>
            <p>{team.description}</p>

            <div class="team-meta">
              <span>{team.trainingDays.join(" • ")}</span>
              {team.acceptsTrial && (
                <span class="mini-link">Probetraining möglich</span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="jugend" class="section light-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Jugend</p>
        <h2>Jugendmannschaften</h2>
      </div>

      <div class="age-group-stack">
        {youthGroups.map((group) => (
          <section id={group.ageGroup.toLowerCase()} class="age-group">
            <div class="age-group-head">
              <div>
                <p class="eyebrow">{group.ageGroup}</p>
                <h3>{group.label}</h3>
              </div>

              <span>{group.teams.length} Teams</span>
            </div>

            <div class="team-grid">
              {group.teams.map((team) => (
                <a class="team-card" href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}>
                  <div class="team-top">
                    <span class="badge">{team.ageGroup}</span>
                    <span class="status-badge">Daten prüfen</span>
                  </div>

                  <h3>{team.name}</h3>
                  <p>{team.description}</p>

                  <div class="team-meta">
                    <span>{team.trainingDays.join(" • ")}</span>
                    {team.acceptsTrial && (
                      <span class="mini-link">Probetraining möglich</span>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section id="einstieg" class="section football-process">
    <div class="container process-grid">
      <article class="process-card">
        <p class="eyebrow">Einstieg</p>
        <h2>Probetraining</h2>
        <p>
          Interessierte Spielerinnen und Spieler können über die Fußball-Probetrainingsseite
          eine strukturierte Anfrage stellen.
        </p>
        <a class="text-link" href="/psv-duesseldorf-website/fussball/probetraining/">
          Zum Fußball-Probetraining →
        </a>
      </article>

      <article class="process-card">
        <p class="eyebrow">Mitgliedschaft</p>
        <h2>Anmeldung</h2>
        <p>
          Nach einem erfolgreichen Probetraining folgt die offizielle Anmeldung über die
          Vereinsunterlagen.
        </p>
        <a class="text-link" href="/psv-duesseldorf-website/mitglied-werden/">
          Mitglied werden →
        </a>
      </article>

      <article class="process-card">
        <p class="eyebrow">Datenmodell</p>
        <h2>Pflegefähig</h2>
        <p>
          Teams, Status, Trainingsdaten und Probetraining werden zentral gepflegt und
          automatisch auf allen Seiten ausgespielt.
        </p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .football-hero {
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 40px;
    align-items: center;
  }

  .hero-card,
  .team-card,
  .process-card {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .hero-card span {
    display: block;
    color: var(--accent-strong);
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.96;
    margin: 18px 0 24px;
  }

  .intro {
    max-width: 740px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .hero-actions,
  .anchor-inner {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .quality-actions {
    margin-top: 28px;
  }

  .hero-actions {
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 900;
  }

  .primary {
    background: var(--accent);
    color: #ffffff;
  }

  .secondary {
    border: 1px solid var(--accent);
    background: #ffffff;
    color: var(--accent-strong);
  }

  .football-anchor-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }

  .anchor-inner {
    overflow-x: auto;
    padding: 14px 0;
  }

  .anchor-inner a {
    white-space: nowrap;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent-strong);
    font-weight: 900;
    text-decoration: none;
  }

  .light-section {
    background: var(--surface);
  }

  .section-head {
    margin-bottom: 30px;
  }

  .team-grid,
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .team-card {
    color: inherit;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .team-top,
  .age-group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 18px;
  }

  .badge,
  .status-badge {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 0.82rem;
  }

  .badge {
    background: rgba(127, 194, 65, 0.12);
    color: var(--accent-strong);
  }

  .status-badge {
    background: #fff7db;
    color: #8a6500;
  }

  .team-card p,
  .process-card p,
  .hero-card p {
    color: var(--muted);
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 22px;
    color: var(--accent-strong);
    font-weight: 800;
  }

  .mini-link,
  .text-link {
    color: var(--accent-strong);
    font-weight: 900;
    text-decoration: none;
  }

  .text-link {
    display: inline-flex;
    margin-top: 22px;
  }

  .age-group-stack {
    display: grid;
    gap: 44px;
  }

  .age-group {
    scroll-margin-top: 96px;
  }

  .age-group-head {
    padding: 24px;
    border-radius: var(--radius);
    background: #ffffff;
    border: 1px solid var(--border);
  }

  .age-group-head h3 {
    margin-bottom: 0;
    font-size: clamp(26px, 3vw, 36px);
  }

  .age-group-head span {
    color: var(--accent-strong);
    font-weight: 900;
  }

  .football-process {
    background: #ffffff;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .team-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .football-anchor-bar {
      top: 0;
    }
  }
</style>
