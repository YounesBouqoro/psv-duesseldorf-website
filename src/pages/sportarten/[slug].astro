---
import Layout from "../../components/layout/Layout.astro";
import { getCollection, render } from "astro:content";
import { withBase } from "../../utils/paths";

export async function getStaticPaths() {
  const sportarten = await getCollection("sportarten");

  return sportarten.map((sport) => ({
    params: { slug: sport.id },
    props: { sport },
  }));
}

const { sport } = Astro.props;
const { Content } = await render(sport);

const trainingItems = sport.data.training ?? [];
const contact = sport.data.contact;
const trialLabels = {
  available: "Probetraining möglich",
  contact: "Vorherige Abstimmung erforderlich",
  unavailable: "Aktuell kein Probetraining"
};
const verifiedDate = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric"
}).format(new Date(`${sport.data.lastVerified}T12:00:00`));
---

<Layout title={sport.data.title} description={sport.data.shortDescription}>
  <section class="section sport-hero">
    <div class="container">
      <a class="back-link" href={withBase("/sportarten/")}>← Zurück zu allen Sportarten</a>
      <p class="eyebrow">{sport.data.category}</p>
      <h1>{sport.data.title}</h1>
      <p class="intro">{sport.data.shortDescription}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-grid">
      <article class="content-card">
        <h2>Über diese Abteilung</h2>
        <div class="prose">
          <Content />
        </div>
      </article>

      <aside class="sidebar">
        {trainingItems.length > 0 && (
          <div class="info-card">
            <h2>Trainingszeiten</h2>
            {trainingItems.map((item) => (
              <div class="training-item">
                <h3>{item.groupName}</h3>
                <p><strong>{item.weekday}</strong><br />{item.startTime}–{item.endTime}</p>
                <p>{item.location}</p>
                {item.notes && <p class="note">{item.notes}</p>}
              </div>
            ))}
          </div>
        )}

        {contact && (
          <div class="info-card">
            <h2>Ansprechpartner</h2>
            <p><strong>{contact.name}</strong><br />{contact.role}</p>
            {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
            {contact.phone && <p><a href={`tel:${contact.phone.replace(/\s/g, "")}`}>{contact.phone}</a></p>}
          </div>
        )}

        <div class="info-card">
          <p class={`availability ${sport.data.trialAvailability}`}>
            {trialLabels[sport.data.trialAvailability]}
          </p>
          <h2>Interesse?</h2>
          {sport.data.trialNote && <p>{sport.data.trialNote}</p>}
          {
            sport.data.trialAvailability !== "unavailable" && (
              <a class="button" href={withBase("/probetraining/")}>Probetraining anfragen</a>
            )
          }
        </div>

        <p class="verified">
          Angaben zuletzt geprüft am {verifiedDate} ·
          <a href={sport.data.sourceUrl} target="_blank" rel="noreferrer"> Originalquelle</a>
        </p>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .sport-hero {
    background: linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .back-link,
  .eyebrow,
  a {
    color: var(--accent-strong);
    font-weight: 900;
    text-decoration: none;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(42px, 7vw, 76px);
    line-height: 0.98;
    margin: 16px 0 24px;
  }

  .intro {
    max-width: 760px;
    color: var(--muted);
    font-size: 1.2rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 28px;
    align-items: start;
  }

  .content-card,
  .info-card {
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .sidebar {
    display: grid;
    gap: 18px;
  }

  .training-item {
    padding-top: 18px;
    margin-top: 18px;
    border-top: 1px solid var(--border);
  }

  .note,
  .verified {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .availability {
    display: inline-flex;
    padding: 7px 12px;
    border-radius: 999px;
    background: #fff4d8;
    color: #765500;
    font-size: 0.82rem;
    font-weight: 900;
  }

  .availability.unavailable {
    background: #fde8e8;
    color: #9b1c1c;
  }

  .verified {
    margin: 0;
    padding: 0 4px;
  }

  .button {
    display: inline-flex;
    margin-top: 16px;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
