---
import Layout from "../components/layout/Layout.astro";
---

<Layout title="Sponsoring">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Partnerschaft</p>
      <h1>Sponsoring beim PSV Düsseldorf</h1>
      <p class="muted">
        Sponsoring soll den Verein, seine Abteilungen und die Weiterentwicklung der Vereinsangebote nachhaltig unterstützen.
      </p>

      <div class="card">
        <h2>Vorteile für Partner</h2>
        <p>
          Die neue Website schafft künftig bessere Sichtbarkeit für Unterstützer, Partner und Sponsoren.
          Mögliche Inhalte sind Partnerprofile, Sponsoringpakete, Kontaktwege und konkrete Unterstützungsbereiche.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .eyebrow {
    color: var(--accent-strong);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
