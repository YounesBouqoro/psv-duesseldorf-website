---
import Layout from "../../components/layout/Layout.astro";
import { footballTeams } from "../../data/footballTeams";

const teams = [...footballTeams].sort((a, b) => a.priority - b.priority);

const stats = {
  total: teams.length,
  trainingszeitenOffen: teams.filter((team) => !team.dataChecklist?.trainingszeitenGeprueft).length,
  trainerOffen: teams.filter((team) => !team.dataChecklist?.trainerGeprueft).length,
  kontaktOffen: teams.filter((team) => !team.dataChecklist?.kontaktGeprueft).length,
  ligaOffen: teams.filter((team) => !team.dataChecklist?.ligaGeprueft).length,
  bildmaterialOffen: teams.filter((team) => !team.dataChecklist?.bildmaterialVorhanden).length
};
---

<Layout title="Fußball Datencheck" robots="noindex, nofollow">
  <section class="section check-hero">
    <div class="container">
      <p class="eyebrow">Interne Pflegefähigkeit</p>
      <h1>Fußball-Datencheck</h1>
      <p class="intro">
        Diese Übersicht dient als interne Arbeitsgrundlage, um Teamdaten vor dem Livegang sauber zu prüfen.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container stats-grid">
      <article class="stat-card">
        <span>{stats.total}</span>
        <strong>Teams gesamt</strong>
      </article>

      <article class="stat-card warning">
        <span>{stats.trainingszeitenOffen}</span>
        <strong>Trainingszeiten offen</strong>
      </article>

      <article class="stat-card warning">
        <span>{stats.trainerOffen}</span>
        <strong>Trainerdaten offen</strong>
      </article>

      <article class="stat-card warning">
        <span>{stats.kontaktOffen}</span>
        <strong>Kontakte offen</strong>
      </article>

      <article class="stat-card warning">
        <span>{stats.ligaOffen}</span>
        <strong>Ligen offen</strong>
      </article>

      <article class="stat-card warning">
        <span>{stats.bildmaterialOffen}</span>
        <strong>Bildmaterial offen</strong>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="template-card">
        <p class="eyebrow">Datenlieferung</p>
        <h2>Vorlage für echte Vereinsdaten</h2>
        <p>
          Die interne Datenvorlage liegt im Projekt unter <strong>src/data/football-datenvorlage.md</strong>.
          Sie definiert, welche Angaben pro Mannschaft vor dem Livegang geprüft und freigegeben werden müssen.
        </p>
      </article>
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Teamübersicht</p>
        <h2>Prüfstatus je Mannschaft</h2>
      </div>

      <div class="check-table-wrap">
        <table class="check-table">
          <thead>
            <tr>
              <th>Team</th>
              <th>Altersklasse</th>
              <th>Training</th>
              <th>Trainer</th>
              <th>Kontakt</th>
              <th>Liga</th>
              <th>Bild</th>
              <th>Teamseite</th>
            </tr>
          </thead>
          <tbody>
            {teams.map((team) => (
              <tr>
                <td><strong>{team.name}</strong></td>
                <td>{team.ageGroup}</td>
                <td>{team.dataChecklist?.trainingszeitenGeprueft ? "✓" : "Offen"}</td>
                <td>{team.dataChecklist?.trainerGeprueft ? "✓" : "Offen"}</td>
                <td>{team.dataChecklist?.kontaktGeprueft ? "✓" : "Offen"}</td>
                <td>{team.dataChecklist?.ligaGeprueft ? "✓" : "Offen"}</td>
                <td>{team.dataChecklist?.bildmaterialVorhanden ? "✓" : "Offen"}</td>
                <td>
                  <a href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}>
                    Öffnen
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<style>
  .check-hero {
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.96;
    margin: 18px 0 24px;
  }

  .intro {
    max-width: 760px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .template-card,
  .stat-card {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .stat-card span {
    display: block;
    color: var(--accent-strong);
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 12px;
  }

  .warning span {
    color: #8a6500;
  }

  .light-section {
    background: var(--surface);
  }

  .section-head {
    margin-bottom: 30px;
  }

  .check-table-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .check-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 920px;
  }

  .check-table th,
  .check-table td {
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .check-table th {
    background: var(--surface);
    color: var(--accent-strong);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .check-table a {
    color: var(--accent-strong);
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
