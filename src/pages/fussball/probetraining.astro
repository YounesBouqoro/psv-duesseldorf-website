---
import Layout from "../../components/layout/Layout.astro";
import { footballTeams } from "../../data/footballTeams";
import { withBase } from "../../utils/paths";

const seniorTeams = footballTeams.filter((team) => team.category === "Senioren");
const youthTeams = footballTeams.filter((team) => team.category === "Jugend");
const youthGroups = [...new Set(youthTeams.map((team) => team.ageGroup))].map((ageGroup) => ({
  ageGroup,
  teams: youthTeams.filter((team) => team.ageGroup === ageGroup)
}));

const mailHref =
  "mailto:anfrage@polizei-sv-duesseldorf.de?subject=Anfrage%20Fu%C3%9Fball-Probetraining%20PSV%20D%C3%BCsseldorf";
---

<Layout
  title="Fußball-Probetraining"
  description="Fußball-Probetraining beim PSV Düsseldorf anfragen: Angaben, Ablauf und passende Mannschaft finden."
>
  <section class="section trial-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Fußball-Probetraining</p>
        <h1>Anfrage richtig zuordnen lassen</h1>
        <p class="intro">
          Die Nachfrage ist hoch und die Plätze sind begrenzt. Eine Anfrage ist möglich,
          die Teilnahme wird aber erst nach Rückmeldung der zuständigen Mannschaft bestätigt.
        </p>
        <div class="actions">
          <a class="button primary" href={mailHref}>Anfrage per E-Mail starten</a>
          <a class="button secondary" href={withBase("/fussball/")}>Zu den Mannschaften</a>
        </div>
      </div>
      <aside class="notice-card">
        <strong>Bitte vollständig anfragen</strong>
        <p>Je genauer die Angaben sind, desto schneller kann die Anfrage zugeordnet werden.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <article class="content-card">
        <p class="eyebrow">Angaben</p>
        <h2>Das gehört in die E-Mail</h2>
        <ul>
          <li>Vorname und Nachname</li>
          <li>Geburtsdatum</li>
          <li>bisherige Fußball- oder Vereinserfahrung</li>
          <li>gewünschte Mannschaft, falls bekannt</li>
          <li>Telefonnummer einer Kontaktperson</li>
        </ul>
      </article>
      <article class="content-card">
        <p class="eyebrow">Ablauf</p>
        <h2>So geht es weiter</h2>
        <ol>
          <li>Anfrage an die zentrale Fußballadresse senden.</li>
          <li>Die Abteilung prüft Mannschaft und Kapazität.</li>
          <li>Erst nach Bestätigung einen Trainingstermin wahrnehmen.</li>
        </ol>
      </article>
    </div>
  </section>

  <section class="section light-section">
    <div class="container section-head">
      <p class="eyebrow">Mannschaften</p>
      <h2>Passende Altersklasse finden</h2>
    </div>
    <div class="container team-block">
      <div>
        <h3>Senioren</h3>
        <div class="team-grid">
          {seniorTeams.map((team) => (
            <a class="team-card" href={withBase(`/fussball/teams/${team.slug}/`)}>
              <span>{team.ageGroup}</span>
              <strong>{team.name}</strong>
            </a>
          ))}
        </div>
      </div>
      {youthGroups.map((group) => (
        <div>
          <h3>{group.ageGroup}</h3>
          <div class="team-grid">
            {group.teams.map((team) => (
              <a class="team-card" href={withBase(`/fussball/teams/${team.slug}/`)}>
                <span>Jahrgang {team.birthYears}</span>
                <strong>{team.name}</strong>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container final-card">
      <p class="eyebrow">Kontakt</p>
      <h2>Spielanfragen und Probetraining</h2>
      <p>Die zentrale Kontaktadresse der Fußballabteilung lautet:</p>
      <a href={mailHref}>anfrage@polizei-sv-duesseldorf.de</a>
    </div>
  </section>
</Layout>

<style>
  .trial-hero {
    background: linear-gradient(135deg, #ffffff, #f2f8ee);
  }
  .hero-grid,
  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 36px;
    align-items: center;
  }
  .split-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
  }
  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 16px 0 24px;
    font-size: clamp(44px, 7vw, 78px);
    line-height: 0.96;
  }
  .intro,
  .notice-card p,
  .final-card p {
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 900;
    text-decoration: none;
  }
  .primary {
    background: var(--accent);
    color: #ffffff;
  }
  .secondary {
    border: 1px solid var(--accent);
    color: var(--accent-strong);
  }
  .notice-card,
  .content-card,
  .team-card,
  .final-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow);
  }
  li {
    margin-bottom: 8px;
  }
  .light-section {
    background: var(--surface);
  }
  .section-head {
    margin-bottom: 26px;
  }
  .team-block {
    display: grid;
    gap: 34px;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .team-card {
    display: grid;
    gap: 8px;
    padding: 20px;
    color: inherit;
    text-decoration: none;
  }
  .team-card span {
    color: var(--accent-strong);
    font-size: 0.85rem;
    font-weight: 900;
  }
  .final-card a {
    color: var(--accent-strong);
    font-size: 1.1rem;
    font-weight: 900;
  }
  @media (max-width: 900px) {
    .hero-grid,
    .split-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
