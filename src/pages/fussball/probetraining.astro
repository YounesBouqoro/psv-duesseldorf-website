---
import Layout from "../../components/layout/Layout.astro";
import { footballTeams } from "../../data/footballTeams";

const trialTeams = footballTeams
  .filter((team) => team.acceptsTrial)
  .sort((a, b) => a.priority - b.priority);
import { footballTeams } from "../../data/footballTeams";

const seniorTeams = footballTeams
  .filter((team) => team.category === "Senioren" && team.acceptsTrial)
  .sort((a, b) => a.priority - b.priority);

const youthTeams = footballTeams
  .filter((team) => team.category === "Jugend" && team.acceptsTrial)
  .sort((a, b) => a.priority - b.priority);

const youthGroups = [
  {
    label: "A-Jugend",
    ageGroup: "U19",
    teams: youthTeams.filter((team) => team.ageGroup === "U19")
  },
  {
    label: "B-Jugend",
    ageGroup: "U17",
    teams: youthTeams.filter((team) => team.ageGroup === "U17")
  },
  {
    label: "C-Jugend",
    ageGroup: "U15",
    teams: youthTeams.filter((team) => team.ageGroup === "U15")
  },
  {
    label: "D-Jugend",
    ageGroup: "U13",
    teams: youthTeams.filter((team) => team.ageGroup === "U13")
  },
  {
    label: "E-Jugend",
    ageGroup: "U11",
    teams: youthTeams.filter((team) => team.ageGroup === "U11")
  },
  {
    label: "F-Jugend",
    ageGroup: "U9",
    teams: youthTeams.filter((team) => team.ageGroup === "U9")
  },
  {
    label: "G-Jugend",
    ageGroup: "U7",
    teams: youthTeams.filter((team) => team.ageGroup === "U7")
  }
];
---

<Layout title="Fußball Probetraining | PSV Düsseldorf">
  <section class="section football-trial-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Fußball Probetraining</p>

        <h1>Probetraining beim PSV Düsseldorf anfragen</h1>

        <p class="intro">
          Der Einstieg in die Fußballabteilung läuft strukturiert über die passende Altersklasse
          oder Mannschaft. So kann die Anfrage später direkt dem richtigen Team zugeordnet werden.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="mailto:anfrage@polizei-sv-duesseldorf.de">
            Anfrage per E-Mail senden
          </a>

          <a class="button secondary" href="/psv-duesseldorf-website/fussball/">
            Zurück zum Fußballbereich
          </a>
        </div>
      </div>

      <div class="hero-card">
        <span>{seniorTeams.length + youthTeams.length}</span>
        <strong>Teams mit Probetrainingsoption</strong>
        <p>Aktuelle Teamdaten werden vor dem Livegang final geprüft.</p>
      </div>
    </div>
  </section>

  <section class="football-anchor-bar">
    <div class="container anchor-inner">
      <a href="#ablauf">Ablauf</a>
      <a href="#senioren">Senioren</a>
      {youthGroups.map((group) => (
        <a href={`#${group.ageGroup.toLowerCase()}`}>{group.label}</a>
      ))}
    </div>
  </section>

  <section id="ablauf" class="section">
    <div class="container split-grid">
      <article class="content-card">
        <p class="eyebrow">Ablauf</p>
        <h2>So läuft die Anfrage ab</h2>

        <ol>
          <li>Passende Altersklasse oder Mannschaft auswählen.</li>
          <li>E-Mail mit Name, Geburtsjahr, Position und bisheriger Fußballerfahrung senden.</li>
          <li>Rückmeldung vom Verein abwarten und Termin abstimmen.</li>
        </ol>
      </article>

      <article class="content-card">
        <p class="eyebrow">Angaben</p>
        <h2>Was in die Anfrage gehört</h2>

        <ul>
          <li>Name des Spielers</li>
          <li>Geburtsjahr</li>
          <li>Telefonnummer der Eltern oder des Spielers</li>
          <li>bisheriger Verein, falls vorhanden</li>
          <li>gewünschte Mannschaft</li>
        </ul>
      </article>
    </div>
  </section>

  <section id="senioren" class="section light-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Senioren</p>
        <h2>Seniorenbereich</h2>
      </div>

      <div class="team-grid">
        {seniorTeams.map((team) => (
          <a class="team-card" href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}>
            <span>{team.ageGroup}</span>
            <h3>{team.name}</h3>
            <p>{team.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container age-group-stack">
      {youthGroups.map((group) => (
        <section id={group.ageGroup.toLowerCase()} class="age-group">
          <div class="age-group-head">
            <div>
              <p class="eyebrow">{group.ageGroup}</p>
              <h2>{group.label}</h2>
            </div>

            <span>{group.teams.length} Teams</span>
          </div>

          <div class="team-grid">
            {group.teams.map((team) => (
              <a class="team-card" href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}>
                <span>{team.ageGroup}</span>
                <h3>{team.name}</h3>
                <p>{team.description}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
  <section class="section light-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Mannschaften</p>
        <h2>Teams mit Probetraining</h2>
      </div>

      <div class="trial-team-grid">
        {trialTeams.map((team) => (
          <a class="trial-team-card" href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}>
            <span>{team.ageGroup}</span>
            <strong>{team.name}</strong>
            <p>{team.trainingDays.join(" • ")}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <article class="request-card">
        <p class="eyebrow">Anfrage vorbereiten</p>
        <h2>Diese Angaben helfen bei der Einordnung</h2>

        <ul class="request-list">
          <li>Name des Spielers oder der Spielerin</li>
          <li>Geburtsjahr</li>
          <li>Gewünschte Mannschaft oder Altersklasse</li>
          <li>Bisheriger Verein oder bisherige Fußballerfahrung</li>
          <li>Position, falls bekannt</li>
          <li>Kontaktdaten der Eltern oder Kontaktperson</li>
          <li>Möglicher Zeitraum für ein Probetraining</li>
        </ul>
      </article>
    </div>
  </section>
  <section class="section light-section">
    <div class="container">
      <article class="trial-contact-card">
        <p class="eyebrow">Nächster Schritt</p>
        <h2>Probetraining anfragen</h2>
        <p>
          Nutze für die erste Anfrage die zentrale Fußball-Kontaktadresse und sende die Angaben aus der Checkliste mit.
        </p>
        <a class="button primary" href="mailto:anfrage@polizei-sv-duesseldorf.de?subject=Anfrage%20Probetraining%20Fu%C3%9Fball%20PSV%20D%C3%BCsseldorf">
          Anfrage per E-Mail starten
        </a>
      </article>
    </div>
  </section>
</Layout>

<style>
  .football-trial-hero {
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 40px;
    align-items: center;
  }

  .hero-card,
  .content-card,
  .team-card,
  .age-group-head {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .hero-card span {
    display: block;
    color: var(--accent-strong);
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.96;
    margin: 18px 0 24px;
  }

  .intro,
  .hero-card p,
  .content-card li,
  .team-card p {
    color: var(--muted);
  }

  .intro {
    max-width: 740px;
    font-size: 1.15rem;
  }

  .hero-actions,
  .anchor-inner {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-actions {
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 900;
  }

  .primary {
    background: var(--accent);
    color: #ffffff;
  }

  .secondary {
    border: 1px solid var(--accent);
    background: #ffffff;
    color: var(--accent-strong);
  }

  .football-anchor-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }

  .anchor-inner {
    overflow-x: auto;
    padding: 14px 0;
  }

  .anchor-inner a {
    white-space: nowrap;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent-strong);
    font-weight: 900;
    text-decoration: none;
  }

  .split-grid,
  .team-grid {
    display: grid;
    gap: 24px;
  }

  .split-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .team-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .team-card {
    color: inherit;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .team-card span,
  .age-group-head > span {
    display: inline-flex;
    margin-bottom: 16px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(127, 194, 65, 0.12);
    color: var(--accent-strong);
    font-weight: 900;
  }

  .light-section {
    background: var(--surface);
  }

  .section-head {
    margin-bottom: 30px;
  }

  .age-group-stack {
    display: grid;
    gap: 44px;
  }

  .age-group {
    scroll-margin-top: 96px;
  }

  .age-group-head {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin-bottom: 24px;
  }

  ol,
  ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .split-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }

    .age-group-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  .trial-team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .trial-team-card {
    padding: 24px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
  }

  .trial-team-card span {
    display: inline-flex;
    margin-bottom: 12px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(127, 194, 65, 0.12);
    color: var(--accent-strong);
    font-weight: 900;
  }

  .trial-team-card p {
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .trial-team-grid {
      grid-template-columns: 1fr;
    }
  }
  .request-card {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .request-list {
    display: grid;
    gap: 12px;
    margin: 22px 0 0;
    padding-left: 20px;
    color: var(--muted);
    font-weight: 700;
  }
  .trial-contact-card {
    padding: 34px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .trial-contact-card p {
    color: var(--muted);
  }
</style>
