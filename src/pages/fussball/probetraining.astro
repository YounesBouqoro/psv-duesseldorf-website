---
import Layout from "../../components/layout/Layout.astro";
import { footballTeams } from "../../data/footballTeams";

const youthTeams = footballTeams.filter((team) => team.category === "Jugend" && team.acceptsTrial).sort((a, b) => a.priority - b.priority);
const seniorTeams = footballTeams.filter((team) => team.category === "Senioren" && team.acceptsTrial).sort((a, b) => a.priority - b.priority);
---

<Layout title="Fußball Probetraining | PSV Düsseldorf">
  <section class="section football-trial-hero">
    <div class="container">
      <p class="eyebrow">Fußball Probetraining</p>

      <h1>Probetraining beim PSV Düsseldorf anfragen</h1>

      <p class="intro">
        Du möchtest beim PSV Düsseldorf Fußball spielen? Dann ist das Probetraining
        der richtige Einstieg. Wähle deine Altersklasse und melde dich mit den wichtigsten Angaben.
      </p>

      <div class="hero-actions">
        <a class="button primary" href="mailto:anfrage@polizei-sv-duesseldorf.de">
          Anfrage per E-Mail senden
        </a>

        <a class="button secondary" href="/psv-duesseldorf-website/fussball/">
          Zurück zum Fußballbereich
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <article class="content-card">
        <p class="eyebrow">Ablauf</p>
        <h2>So läuft die Anfrage ab</h2>

        <ol>
          <li>Passende Altersklasse oder Mannschaft auswählen.</li>
          <li>E-Mail mit Name, Geburtsjahr, Position und bisheriger Fußballerfahrung senden.</li>
          <li>Rückmeldung vom Verein abwarten und Termin abstimmen.</li>
        </ol>
      </article>

      <article class="content-card">
        <p class="eyebrow">Wichtig</p>
        <h2>Angaben in der Anfrage</h2>

        <ul>
          <li>Name des Spielers</li>
          <li>Geburtsjahr</li>
          <li>Telefonnummer der Eltern oder des Spielers</li>
          <li>bisheriger Verein, falls vorhanden</li>
          <li>gewünschte Mannschaft</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Mannschaften</p>
        <h2>Jugendteams</h2>
      </div>

      <div class="team-grid">
        {youthTeams.map((team) => (
          <a class="team-card" href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}>
            <span>{team.ageGroup}</span>
            <h3>{team.name}</h3>
            <p>{team.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Senioren</p>
        <h2>Seniorenbereich</h2>
      </div>

      <div class="team-grid">
        {seniorTeams.map((team) => (
          <a class="team-card" href={`/psv-duesseldorf-website/fussball/teams/${team.slug}/`}>
            <span>{team.ageGroup}</span>
            <h3>{team.name}</h3>
            <p>{team.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .football-trial-hero {
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.96;
    margin: 18px 0 24px;
  }

  .intro {
    max-width: 740px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 900;
  }

  .primary {
    background: var(--accent);
    color: #ffffff;
  }

  .secondary {
    border: 1px solid var(--accent);
    background: #ffffff;
    color: var(--accent-strong);
  }

  .split-grid,
  .team-grid {
    display: grid;
    gap: 24px;
  }

  .split-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .team-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .content-card,
  .team-card {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .team-card {
    text-decoration: none;
    color: inherit;
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .team-card span {
    display: inline-flex;
    margin-bottom: 16px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(127, 194, 65, 0.12);
    color: var(--accent-strong);
    font-weight: 900;
  }

  .team-card p,
  .content-card li {
    color: var(--muted);
  }

  .light-section {
    background: var(--surface);
  }

  ol,
  ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  @media (max-width: 980px) {
    .split-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

