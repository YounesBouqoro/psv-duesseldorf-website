---
import Layout from "../../../components/layout/Layout.astro";
import { footballTeams } from "../../../data/footballTeams";

export async function getStaticPaths() {
  return footballTeams.map((team) => ({
    params: {
      slug: team.slug
    },
    props: {
      team
    }
  }));
}

const { team } = Astro.props;
---

<Layout title={team.name}>
  <section class="section team-hero">
    <div class="container breadcrumb">
      <a href="/psv-duesseldorf-website/fussball/">Fußball</a>
      <span>/</span>
      <span>{team.name}</span>
    </div>
    <div class="container">
      <div class="hero-labels">
        <p class="eyebrow">{team.category}</p>
        <span class="status-badge">Daten vor Livegang prüfen</span>
      </div>

      <h1>{team.name}</h1>

      <p class="intro">
        {team.description}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container info-grid">
      <article class="info-card">
        <h2>Altersklasse</h2>
        <p>{team.ageGroup}</p>
      </article>

      <article class="info-card">
        <h2>Trainingstage</h2>
        <p>{team.trainingDays.join(" • ")}</p>
      </article>

      <article class="info-card">
        <h2>Trainingsort</h2>
        <p>{team.location}</p>
      </article>
    </div>
  </section>

  <section class="section light-section">
    <div class="container split-grid">
      <article class="content-card">
        <p class="eyebrow">Trainerteam</p>

        <h2>Betreuung der Mannschaft</h2>

        <ul>
          {team.coaches.map((coach) => (
            <li>{coach}</li>
          ))}
        </ul>
      </article>

      <article class="content-card">
        <p class="eyebrow">Probetraining</p>

        <h2>{team.acceptsTrial ? "Probetraining anfragen" : "Probetraining anfragen"}</h2>

        <p>
          Für Anfragen zum Probetraining oder zur Mannschaft bitte direkt Probetraining anfragen.
        </p>

        <a
          class="button primary"
          href={`/psv-duesseldorf-website/fussball/probetraining/`}
        >
          Probetraining anfragen
        </a>
      </article>
    </div>
  </section>
  <section class="section">
    <div class="container steps-grid">
      <article class="step-card">
        <span>01</span>
        <h2>Anfrage senden</h2>
        <p>
          Nutze die Probetrainingsseite und gib Name, Geburtsjahr, Erfahrung und gewünschte Mannschaft an.
        </p>
      </article>

      <article class="step-card">
        <span>02</span>
        <h2>Rückmeldung erhalten</h2>
        <p>
          Das Trainer- oder Organisationsteam prüft die Anfrage und stimmt einen passenden Termin ab.
        </p>
      </article>

      <article class="step-card">
        <span>03</span>
        <h2>Mittrainieren</h2>
        <p>
          Beim Probetraining lernst du Mannschaft, Trainerteam und die Abläufe beim PSV Düsseldorf kennen.
        </p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .team-hero {
    background:
      radial-gradient(circle at top right, rgba(127, 194, 65, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.96;
    margin: 18px 0 24px;
  }

  .intro {
    max-width: 720px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .info-card,
  .content-card {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .light-section {
    background: var(--surface);
  }

  .split-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
    text-decoration: none;
    font-weight: 900;
    margin-top: 24px;
  }

  ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  @media (max-width: 980px) {
    .info-grid,
    .split-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero-labels {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    background: #fff7db;
    color: #8a6500;
    font-size: 0.82rem;
    font-weight: 900;
  }
  .breadcrumb {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 24px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .breadcrumb a {
    color: var(--accent-strong);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .step-card {
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .step-card span {
    display: inline-flex;
    margin-bottom: 18px;
    color: var(--accent-strong);
    font-size: 1.8rem;
    font-weight: 900;
  }

  .step-card p {
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>




