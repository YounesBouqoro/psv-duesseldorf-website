---
import Layout from "../../../components/layout/Layout.astro";
import { footballTeams, type FootballTeam } from "../../../data/footballTeams";
import { withBase } from "../../../utils/paths";

export async function getStaticPaths() {
  return footballTeams.map((team) => ({
    params: { slug: team.slug },
    props: { team }
  }));
}

interface Props {
  team: FootballTeam;
}

const { team } = Astro.props;
const relatedTeams = footballTeams
  .filter((item) => item.ageGroup === team.ageGroup && item.slug !== team.slug)
  .sort((a, b) => a.priority - b.priority);

const mailHref = `mailto:${team.contactMail}?subject=Anfrage%20${encodeURIComponent(team.name)}%20PSV%20D%C3%BCsseldorf`;
---

<Layout
  title={`${team.name} Fußball`}
  description={team.description}
>
  <section class="section team-hero">
    <div class="container breadcrumb">
      <a href={withBase("/fussball/")}>Fußball</a>
      <span>/</span>
      <span>{team.name}</span>
    </div>
    <div class="container">
      <p class="eyebrow">{team.category} · {team.ageGroup}</p>
      <h1>{team.name}</h1>
      <p class="intro">{team.description}</p>
      <div class="actions">
        <a class="button primary" href={mailHref}>Anfrage senden</a>
        <a class="button secondary" href={withBase("/fussball/probetraining/")}>Probetraining-Ablauf</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container info-grid">
      <article class="info-card">
        <p class="eyebrow">Mannschaft</p>
        <h2>{team.ageGroup}</h2>
        {team.birthYears && <p>Veröffentlichte Jahrgänge: {team.birthYears}</p>}
      </article>
      <article class="info-card">
        <p class="eyebrow">Sportanlage</p>
        <h2>Grafenberg</h2>
        <p>{team.location}</p>
      </article>
      <article class="info-card">
        <p class="eyebrow">Kontakt</p>
        <h2>Zentrale Anfrage</h2>
        <a href={mailHref}>{team.contactMail}</a>
      </article>
    </div>
  </section>

  <section class="section light-section">
    <div class="container capacity-card">
      <p class="eyebrow">Wichtiger Hinweis</p>
      <h2>Teilnahme erst nach Bestätigung</h2>
      <p>
        Aufgrund der hohen Nachfrage sind die Kapazitäten im Jugendbereich begrenzt.
        Bitte nicht unangemeldet zum Training erscheinen. Die Fußballabteilung ordnet
        die Anfrage zu und meldet sich mit den nächsten Schritten.
      </p>
    </div>
  </section>

  {relatedTeams.length > 0 && (
    <section class="section">
      <div class="container section-head">
        <p class="eyebrow">Gleiche Altersklasse</p>
        <h2>Weitere Teams</h2>
      </div>
      <div class="container related-grid">
        {relatedTeams.map((related) => (
          <a class="related-card" href={withBase(`/fussball/teams/${related.slug}/`)}>
            <span>{related.ageGroup}</span>
            <strong>{related.name}</strong>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .team-hero {
    background: linear-gradient(135deg, #ffffff, #f2f8ee);
  }
  .breadcrumb {
    display: flex;
    gap: 10px;
    margin-bottom: 30px;
    color: var(--muted);
  }
  .breadcrumb a,
  .info-card a {
    color: var(--accent-strong);
    font-weight: 900;
  }
  .eyebrow {
    color: var(--accent-strong);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 16px 0 24px;
    font-size: clamp(48px, 8vw, 86px);
    line-height: 0.96;
  }
  .intro {
    max-width: 760px;
    color: var(--muted);
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 900;
    text-decoration: none;
  }
  .primary {
    background: var(--accent);
    color: #ffffff;
  }
  .secondary {
    border: 1px solid var(--accent);
    color: var(--accent-strong);
  }
  .info-grid,
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  .info-card,
  .capacity-card,
  .related-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow);
  }
  .info-card p,
  .capacity-card p {
    color: var(--muted);
  }
  .light-section {
    background: var(--surface);
  }
  .capacity-card {
    max-width: 820px;
  }
  .section-head {
    margin-bottom: 24px;
  }
  .related-card {
    display: grid;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  .related-card span {
    color: var(--accent-strong);
    font-weight: 900;
  }
  @media (max-width: 850px) {
    .info-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
