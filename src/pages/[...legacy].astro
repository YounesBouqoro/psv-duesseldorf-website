---
import { withBase } from "../utils/paths";

export function getStaticPaths() {
  const legacyRedirects = {
  "dsgvo": "/datenschutz/",
  "anmeldungen-fussball": "/fussball/probetraining/",
  "elementor-4117": "/kurse/",
  "category/allgemein": "/",
  "category/blog": "/",
  "category/fussball": "/sportarten/fussball/",
  "category/hundesport": "/sportarten/hundesport/",
  "category/judo": "/sportarten/judo/",
  "category/karate": "/sportarten/karate/",
  "category/kurse": "/kurse/",
  "fussball-senioren-1-mannschaft": "/fussball/teams/1-mannschaft/",
  "fussball-senioren-2-mannschaft": "/fussball/teams/2-mannschaft/",
  "fussball-senioren-alte-herren": "/fussball/teams/alte-herren/",
  "fussball-jugend-a1": "/fussball/teams/a1/",
  "fussball-jugend-b1": "/fussball/teams/b1/",
  "fussball-jugend-b2": "/fussball/teams/b2/",
  "fussball-jugend-c1": "/fussball/teams/c1/",
  "fussball-jugend-c2": "/fussball/teams/c2/",
  "fussball-jugend-c3": "/fussball/teams/c3/",
  "fussball-jugend-d1": "/fussball/teams/d1/",
  "fussball-jugend-d2": "/fussball/teams/d2/",
  "fussball-jugend-d3": "/fussball/teams/d3/",
  "fussball-jugend-e1": "/fussball/teams/e1/",
  "fussball-jugend-e2": "/fussball/teams/e2/",
  "fussball-jugend-e3": "/fussball/teams/e3/",
  "fussball-jugend-e4": "/fussball/teams/e4/",
  "fussball-jugend-f1": "/fussball/teams/f1/",
  "fussball-jugend-f2": "/fussball/teams/f2/",
  "fussball-jugend-f3": "/fussball/teams/f3/",
  "fussball-jugend-f4": "/fussball/teams/f4/",
  "fussball-jugend-g1": "/fussball/teams/g1/",
  "fussball-jugend-g2": "/fussball/teams/g2/",
  "fussball-jugend-g3": "/fussball/teams/g3/"
  } as const;

  return Object.entries(legacyRedirects).map(([legacy, destination]) => ({
    params: { legacy },
    props: { destination }
  }));
}

const { destination } = Astro.props;
const target = withBase(destination);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Weiterleitung | PSV Düsseldorf</title>
  </head>
  <body>
    <p>Die Seite wurde verschoben. <a href={target}>Weiter zum neuen Inhalt</a>.</p>
  </body>
</html>
