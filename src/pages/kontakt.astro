---
import Layout from "../components/layout/Layout.astro";
import { withBase } from "../utils/paths";
---

<Layout title="Kontakt" description="Kontakt, Anschrift und Bürozeiten des Polizei-Sport-Verein Düsseldorf e.V.">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Kontakt</p>
      <h1>So erreichst du den PSV Düsseldorf</h1>
      <p class="intro">Geschäftsstelle, Sportanlage und direkte Einstiege für dein Anliegen.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <article class="contact-card">
        <p class="eyebrow">Geschäftsstelle</p>
        <h2>Polizei-Sport-Verein Düsseldorf e.V.</h2>
        <address>
          Ernst-Poensgen-Allee 60<br />
          40629 Düsseldorf
        </address>
        <p>Montag bis Donnerstag: 8:30–13:30 Uhr</p>
        <p>
          <a href="tel:+4921173283065">0211 / 73 28 30 65</a><br />
          <a href="mailto:contact@polizei-sv-duesseldorf.de">contact@polizei-sv-duesseldorf.de</a>
        </p>
        <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Ernst-Poensgen-Allee+60+40629+D%C3%BCsseldorf" target="_blank" rel="noreferrer">Route öffnen</a>
      </article>

      <article class="contact-card">
        <p class="eyebrow">Sportanfragen</p>
        <h2>Probetraining und Mitgliedschaft</h2>
        <p>Allgemeine Sportanfragen werden über die Geschäftsstelle an die zuständige Abteilung weitergeleitet.</p>
        <div class="link-stack">
          <a href={withBase("/probetraining/")}>Probetraining anfragen</a>
          <a href={withBase("/fussball/probetraining/")}>Fußball-Probetraining</a>
          <a href={withBase("/mitglied-werden/")}>Mitglied werden</a>
          <a href={withBase("/downloads/")}>Formulare und Downloads</a>
        </div>
      </article>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, #ffffff, #f2f8ee); }
  .eyebrow { color: var(--accent-strong); font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 16px 0 20px; font-size: clamp(44px, 7vw, 76px); }
  .intro, .contact-card p, address { color: var(--muted); }
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .contact-card { padding: 32px; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow); }
  address { margin-bottom: 18px; font-style: normal; }
  .contact-card a { color: var(--accent-strong); font-weight: 900; }
  .link-stack { display: grid; gap: 12px; margin-top: 22px; }
  @media (max-width: 780px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
