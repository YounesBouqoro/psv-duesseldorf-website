---
import Layout from "../components/layout/Layout.astro";

const contactOptions = [
  {
    title: "Allgemeine Anfrage",
    text: "Für Fragen zum Verein, zur Geschäftsstelle oder zu allgemeinen Themen.",
    email: "kontakt@polizei-sv-duesseldorf.de"
  },
  {
    title: "Probetraining",
    text: "Für Interessierte, die eine Sportart kennenlernen möchten.",
    email: "kontakt@polizei-sv-duesseldorf.de"
  },
  {
    title: "Mitgliedschaft",
    text: "Für Fragen zu Beitritt, Formularen und Vereinsmitgliedschaft.",
    email: "kontakt@polizei-sv-duesseldorf.de"
  }
];
---

<Layout title="Kontakt">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Kontakt</p>
      <h1>So erreichst du den PSV Düsseldorf</h1>
      <p class="intro">
        Für Anfragen zu Verein, Mitgliedschaft, Sportarten und Probetraining werden die Kontaktwege zentral gebündelt.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="main-card">
        <h2>Geschäftsstelle</h2>
        <p>
          Polizei-Sport-Verein Düsseldorf e.V.<br />
          Düsseldorf
        </p>

        <div class="contact-row">
          <strong>E-Mail</strong>
          <a href="mailto:kontakt@polizei-sv-duesseldorf.de">kontakt@polizei-sv-duesseldorf.de</a>
        </div>

        <div class="contact-row">
          <strong>Hinweis</strong>
          <span>Adresse, Telefonnummer und Bürozeiten werden vor dem finalen Launch verifiziert.</span>
        </div>
      </div>

      <div class="side-card">
        <h2>Schnelleinstieg</h2>
        <a href="/psv-duesseldorf-website/probetraining/">Probetraining anfragen</a>
        <a href="/psv-duesseldorf-website/mitglied-werden/">Mitglied werden</a>
        <a href="/psv-duesseldorf-website/downloads/">Downloads ansehen</a>
      </div>
    </div>
  </section>

  <section class="section light-section">
    <div class="container">
      <p class="eyebrow">Anliegen</p>
      <h2>Worum geht es?</h2>

      <div class="option-grid">
        {contactOptions.map((option) => (
          <article class="option-card">
            <h3>{option.title}</h3>
            <p>{option.text}</p>
            <a href={`mailto:${option.email}`}>{option.email}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #ffffff 0%, #f4f8f1 100%);
  }

  .eyebrow {
    color: var(--accent-strong);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 980px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.98;
    margin: 16px 0 24px;
  }

  .intro {
    max-width: 760px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 24px;
  }

  .main-card,
  .side-card,
  .option-card {
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: 28px;
    background: #ffffff;
    box-shadow: 0 16px 50px rgba(0,0,0,0.06);
  }

  .contact-row {
    display: grid;
    gap: 6px;
    padding-top: 18px;
    margin-top: 18px;
    border-top: 1px solid var(--border);
  }

  a {
    color: var(--accent-strong);
    font-weight: 800;
    text-decoration: none;
  }

  .side-card {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .light-section {
    background: var(--surface);
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 26px;
  }

  .option-card p,
  .main-card p,
  .contact-row span {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .contact-grid,
    .option-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
