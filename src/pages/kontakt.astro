---
import Layout from "../components/layout/Layout.astro";
---

<Layout title="Kontakt">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Kontakt</p>
      <h1>Kontakt zum PSV Düsseldorf</h1>
      <p class="muted">
        Die Website soll künftig klare Kontaktwege für Mitgliedschaft, Probetraining, Sportarten, Sponsoring und allgemeine Vereinsanfragen bereitstellen.
      </p>

      <div class="card">
        <h2>Kontaktinformationen folgen</h2>
        <p>
          Offizielle E-Mail-Adressen, Telefonnummern, Ansprechpartner und Standorte werden nach Freigabe ergänzt.
          Bis dahin bleibt diese Seite als strukturierter Platzhalter bestehen.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .eyebrow {
    color: var(--accent-strong);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
